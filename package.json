{
  "name": "wanted-guild-manager",
  "private": true,
  "description": "Create, manage, and track sign ups for Wanted Guild PvX events (Throne and Liberty).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
