# Copy to .env for local runs, or to .env.staging / .env.production for the
# droplet (installed by `inv deploy`). Never commit these files.
# All values come from the Discord Developer Portal for that environment's app.

# General Information > Public Key (required)
WGM_DISCORD_PUBLIC_KEY=

# General Information > Application ID (to register commands)
WGM_DISCORD_APPLICATION_ID=

# Bot > Reset Token (to call Discord's API; keep it secret)
WGM_DISCORD_BOT_TOKEN=

# Right-click your server in Discord > Copy Server ID (staging only: commands
# registered to one server show up at once)
WGM_DISCORD_GUILD_ID=

# Plugins to turn on, comma separated (default: event).
# WGM_PLUGINS=event

# Staging only: adds commands for trying plugins by hand, such as
# `/wgm event seed` for test events. Never turn this on in production.
# WGM_DEV_MODE=true

# event plugin: how often to check for posts whose sign-ups closed (default 60)
# WGM_EVENT_CLOSE_CHECK_SECONDS=60
